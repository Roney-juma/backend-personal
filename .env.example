# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# JWT / token config
JWT_REFRESH_EXPIRATION_HOURS=24
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_KEY=<random-string>

# Auth token signing — TOKEN_SECRET is the passphrase for keys/private.pem.
# Generate keys with: see README / rotate-keys step. Rotating TOKEN_SECRET requires
# regenerating the keypair with the same passphrase, and logs out all existing users.
TOKEN_SECRET=<random-64-hex>
ENCRYPTION_SECRET=<random-64-hex>
TOKEN_ISSUER=EVE API

# AWS (S3 uploads)
BUCKET_NAME=<bucket>
BUCKET_NAME_DEFAULT=<bucket>
ACCESS_KEY=<aws-access-key-id>
SECRET_ID_AWS=<aws-access-key-id>
SECRET_KEY_AWS=<aws-secret-access-key>
AWS_REGION=us-east-1

# Backup & recovery (see docs/BACKUP_RECOVERY.md). Run `npm run backup:setup` once.
BACKUP_BUCKET=<db-backup-bucket>
BACKUP_PREFIX=db/
BACKUP_REGION=us-east-1
BACKUP_RETENTION_DAYS=30
CLAIMS_NONCURRENT_DAYS=90
# Cross-region replication for DR (run `npm run dr:replicate`). DR_REGION != AWS_REGION.
DR_BUCKET=<claim-files-dr-bucket>
DR_REGION=us-west-2
REPLICATION_ROLE_NAME=ave-s3-replication-role
# REPLICATION_ROLE_ARN=<pre-made-role-arn-to-skip-IAM-creation>
# REPLICATE_DELETE_MARKERS=false
# MONGODUMP_PATH=/usr/bin/mongodump
# MONGORESTORE_PATH=/usr/bin/mongorestore
# RESTORE_URI=<scratch-cluster-uri-for-rehearsing-restores>

# Email (SMTP)
EMAIL_HOST=<smtp-host>
EMAIL_PORT=465
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>

# Firebase service account (from GCP console; keep the \n escapes in the private key)
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_CLIENT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<...>\n-----END PRIVATE KEY-----\n"

# Redis (async notification queue + worker)
REDIS_URL=redis://localhost:6379

# WhatsApp Business API (Meta Cloud API)
# Use a current Graph API version (v17.0 is deprecated). Include the phone-number-id.
WHATSAPP_API_URL=https://graph.facebook.com/v21.0/<phone-number-id>
WHATSAPP_ACCESS_TOKEN=<meta-system-user-token>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<business-account-id>
# Name of the approved template used to wrap outbound notifications so they
# deliver outside the 24h session window. Must have exactly one body variable {{1}}.
# Leave unset to send free-form text (only delivers inside the 24h window).
WHATSAPP_DEFAULT_TEMPLATE=ave_notification
WHATSAPP_TEMPLATE_LANG=en_US

# GitHub deploy webhook (webhook.js)
WEBHOOK_SECRET=<random-hex>
WEBHOOK_PORT=4000

# Security — CORS allowlist (comma-separated browser origins) + rate limiting.
# Used by both the HTTP API and Socket.IO. If unset, only localhost dev origins are allowed.
CORS_ORIGINS=https://app.aveafrica.com,https://admin.aveafrica.com,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
